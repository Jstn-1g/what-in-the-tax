    <!-- Members scripts-->
    <script type="text/javascript">
        $(document).ready(function () {
            $.ajax({
                type: 'GET',
                url: '/umbraco/surface/GOVMemberSurface/GetMemberValue',
                data: {
                    pageId: $("[data-area='memberArea']").data("content"),
                },
                success: function (data) {
                    $("[data-area='memberArea']").html(data);
                },
                error: function (data) {
                }
            });
        });
    </script>

    
    

    

