{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditback.ca/schemas/verified-jurisdiction-directory.schema.json",
  "title": "AuditBack verified jurisdiction directory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jurisdiction",
    "candidateOnly",
    "adapter",
    "sourceLockCanonicalSha256",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "auditback-verified-jurisdiction-directory-1.0.0"
    },
    "jurisdiction": {
      "enum": ["AB", "BC", "MB", "NB", "NL", "NS", "NT", "NU", "ON", "PE", "QC", "SK", "YT"]
    },
    "candidateOnly": {"type": "boolean"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": ["string", "null"], "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "sourceLockCanonicalSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["body", "provenance"],
        "properties": {
          "body": {
            "$ref": "https://auditback.ca/schemas/canonical-government-directory.schema.json#/$defs/governingBody"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "snapshotSha256",
              "recordKey",
              "sourceFields",
              "transform",
              "adapterId",
              "adapterVersion",
              "identityFieldMap",
              "geographyEvidence",
              "relationshipEvidence"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "snapshotSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recordKey": {"type": "string", "minLength": 1},
              "sourceFields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "transform": {"type": "string", "minLength": 1},
              "adapterId": {"type": "string", "minLength": 1},
              "adapterVersion": {"type": "string", "minLength": 1},
              "identityFieldMap": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "externalId",
                  "officialName",
                  "officialLegalType",
                  "officialUrl"
                ],
                "properties": {
                  "externalId": {"type": "string", "minLength": 1},
                  "officialName": {"type": "string", "minLength": 1},
                  "officialLegalType": {"type": "string", "minLength": 1},
                  "officialUrl": {"type": "string", "minLength": 1}
                }
              },
              "geographyEvidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/geographyEvidence"}
              },
              "relationshipEvidence": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/relationshipEvidence"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceEvidenceBase": {
      "type": "object",
      "required": [
        "sourceId",
        "snapshotSha256",
        "recordKey",
        "sourceFields",
        "transform"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordKey": {"type": "string", "minLength": 1},
        "sourceFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "transform": {"type": "string", "minLength": 1}
      }
    },
    "geographyEvidence": {
      "allOf": [
        {"$ref": "#/$defs/sourceEvidenceBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["geographyId"],
          "properties": {
            "sourceId": true,
            "snapshotSha256": true,
            "recordKey": true,
            "sourceFields": true,
            "transform": true,
            "geographyId": {
              "type": "string",
              "pattern": "^ca:sgc:[0-9]{4}:(?:census-division|census-subdivision):[0-9]+$"
            }
          }
        }
      ]
    },
    "relationshipEvidence": {
      "allOf": [
        {"$ref": "#/$defs/sourceEvidenceBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parentBodyId"],
          "properties": {
            "sourceId": true,
            "snapshotSha256": true,
            "recordKey": true,
            "sourceFields": true,
            "transform": true,
            "parentBodyId": {
              "type": "string",
              "pattern": "^ca:[a-z0-9][a-z0-9:._-]+$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"candidateOnly": {"const": false}},
        "required": ["candidateOnly"]
      },
      "then": {
        "properties": {
          "adapter": {
            "properties": {
              "id": {"type": "string"},
              "version": {"type": "string"}
            }
          },
          "sourceLockCanonicalSha256": {"type": "string"},
          "records": {"minItems": 1}
        }
      }
    }
  ]
}
