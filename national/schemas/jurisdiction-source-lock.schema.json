{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditback.ca/schemas/jurisdiction-source-lock.schema.json",
  "title": "AuditBack jurisdiction source lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceBundleCanonicalSha256",
    "coverageLayerCanonicalSha256",
    "snapshots",
    "sourceLockCanonicalSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "auditback-jurisdiction-source-lock-1.0.0"
    },
    "sourceBundleCanonicalSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverageLayerCanonicalSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sha256",
          "byteLength",
          "mediaType",
          "requestUrl",
          "objectPath"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byteLength": {"type": "integer", "minimum": 1},
          "mediaType": {"type": "string", "minLength": 1},
          "requestUrl": {"type": "string", "pattern": "^https://"},
          "retrievedAt": {"type": "string", "minLength": 1},
          "effectiveDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "etag": {"type": "string", "minLength": 1},
          "lastModified": {"type": "string", "minLength": 1},
          "objectPath": {"type": "string", "minLength": 1}
        },
        "anyOf": [
          {"required": ["retrievedAt"]},
          {"required": ["effectiveDate"]}
        ]
      }
    },
    "sourceLockCanonicalSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
