{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditback.ca/schemas/sgc-geography-index-1.0.0.json",
  "title": "AuditBack pinned SGC geography index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "classificationVersion",
    "source",
    "counts",
    "geographyIds",
    "indexCanonicalSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "auditback-sgc-geography-index-1.0.0"
    },
    "classificationVersion": {
      "const": "2021"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sha256"
      ],
      "properties": {
        "sourceId": {
          "const": "statcan-sgc-2021-structure-en"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "province-territory",
        "census-division",
        "census-subdivision"
      ],
      "properties": {
        "region": {
          "type": "integer",
          "minimum": 1
        },
        "province-territory": {
          "type": "integer",
          "minimum": 1
        },
        "census-division": {
          "type": "integer",
          "minimum": 1
        },
        "census-subdivision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "geographyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ca:sgc:2021:(?:region:[0-9]|province-territory:[0-9]{2}|census-division:[0-9]{4}|census-subdivision:[0-9]{7})$"
      }
    },
    "indexCanonicalSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
