{
  "name": "what-in-the-tax-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "//heapNote": "tsc/vitest are invoked via node --max-old-space-size because the default heap on some installs aborts them with a V8 allocation failure",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc && vite build",
    "preview": "vite preview",
    "test": "node --max-old-space-size=2048 ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
