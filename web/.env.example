# Optional hosted payment pages. Leave blank until real HTTPS URLs are ready.
VITE_SUPPORT_ONCE_URL=
VITE_SUPPORT_MONTHLY_URL=

# Optional override for the footer's repository link. Defaults to the canonical
# public repository (https://github.com/Jstn-1g/what-in-the-tax); set this only
# when a fork or mirror deploys its own copy. Must be a plain https GitHub
# repository URL or it is ignored in favour of the canonical one.
VITE_REPO_URL=
